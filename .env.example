# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional key for OpenAI Provider in Multi-AI Orchestrator.
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Resend API Key for sending real transactional emails (Welcome & Verification)
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Sender address (e.g. "Rafiq AI <onboarding@resend.dev>" or "support@yourdomain.com")
RESEND_FROM_EMAIL="Rafiq AI <onboarding@resend.dev>"

# GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID from Google Cloud Console for Google Sign-In
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""
